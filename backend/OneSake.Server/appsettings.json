{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=onesake;Username=onesake;Password=onesake"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*",
  "Match": {
    "ReconnectGraceSeconds": 90,
    "ReconnectBudgetSeconds": 180,
    "LobbyReconnectGraceSeconds": 30,
    "Timer": {
      "TurnSeconds": 90,
      "ResponseSeconds": 25,
      "MulliganSeconds": 30,
      "TurnOrderSeconds": 20,
      "TimeBankStartSeconds": 180,
      "TimeBankBonusSeconds": 10,
      "TimeBankMaxSeconds": 240,
      "ToleranceSeconds": 2
    }
  },
  "Meta": {
    "Enabled": false,
    "Provider": "CardKaizoku",
    "BaseUrl": "https://cdn.cardkaizoku.com/stats/",
    "Format": "eb05_lw_p_top20",
    "AttributionName": "Card Kaizoku",
    "AttributionUrl": "https://cardkaizoku.com/"
  }
}
